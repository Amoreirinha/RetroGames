@host = http://localhost:5080

### ---------- Leitura (pública) ----------
GET {{host}}/api/Plataforma
###
GET {{host}}/api/Plataforma/99
###
GET {{host}}/api/Genero
###
GET {{host}}/api/CondicaoJogo
###
GET {{host}}/api/Jogo?pagina=1&tamanhoPagina=5
###
GET {{host}}/api/Jogo/9999

### ---------- Acesso (Aula 6) ----------
# POST sem login -> 401, responseCode 4
POST {{host}}/api/Plataforma
Content-Type: application/json

{ "nome": "Super Nintendo", "fabricante": "Nintendo", "anoLancamento": 1990 }
###
# Login com senha errada -> 401, responseCode 6
POST {{host}}/api/Autenticacao/login
Content-Type: application/json

{ "email": "admin@retrogames.com", "senha": "senha-errada" }
###
# Login com e-mail mal formado -> 400, responseCode 3, campos em data
POST {{host}}/api/Autenticacao/login
Content-Type: application/json

{ "email": "isto-nao-e-email", "senha": "x" }
###
# Login do administrador (ajuste o e-mail e a senha do seu .env) -> 200
# @name login
POST {{host}}/api/Autenticacao/login
Content-Type: application/json

{ "email": "admin@retrogames.com", "senha": "COLOQUE_A_SENHA_AQUI" }
###
GET {{host}}/api/Autenticacao/eu
###
POST {{host}}/api/Autenticacao/logout
###
# Depois do logout -> 401, responseCode 4
GET {{host}}/api/Autenticacao/eu
###
# incluirInativos sem login -> 200, só jogos ativos
GET {{host}}/api/Jogo?incluirInativos=true

### ---------- Gravação (Aula 5; com login de administrador a partir da Aula 6) ----------
# 201 + Location
POST {{host}}/api/Plataforma
Content-Type: application/json

{ "nome": "Super Nintendo", "fabricante": "Nintendo", "anoLancamento": 1990 }
###
# 400, código 3, erros por campo
POST {{host}}/api/Plataforma
Content-Type: application/json

{ "nome": "", "fabricante": "Nintendo", "anoLancamento": 1800 }
###
# 400, código 3 (JSON malformado)
POST {{host}}/api/Plataforma
Content-Type: application/json

{ "nome": "Sem aspa final, "fabricante": "Nintendo" }
###
# 409, código 101 (nome repetido: rode o POST válido duas vezes)
POST {{host}}/api/Plataforma
Content-Type: application/json

{ "nome": "Super Nintendo", "fabricante": "Nintendo", "anoLancamento": 1990 }
###
# 200 com o registro alterado (troque o 3 por um id que exista)
PUT {{host}}/api/Plataforma/3
Content-Type: application/json

{ "nome": "Super Famicom", "fabricante": "Nintendo", "anoLancamento": 1990 }
###
# 404, código 100
PUT {{host}}/api/Plataforma/99
Content-Type: application/json

{ "nome": "Inexistente", "fabricante": "Ninguém", "anoLancamento": 2000 }
###
# 200; com jogos vinculados -> 409, código 102
DELETE {{host}}/api/Plataforma/3
###
# Jogo: 201 + Location (ajuste os ids de plataforma, condição e gêneros)
POST {{host}}/api/Jogo
Content-Type: application/json

{ "nome": "Super Mario World", "descricao": "Clássico de plataforma.", "preco": 199.90, "estoque": 3, "idPlataforma": 1, "idCondicaoJogo": 1, "idsGeneros": [1] }
###
# Jogo com referência inexistente -> 404, código 104 (condição)
POST {{host}}/api/Jogo
Content-Type: application/json

{ "nome": "Teste", "preco": 10, "estoque": 1, "idPlataforma": 1, "idCondicaoJogo": 999, "idsGeneros": [] }
###
# Jogo com preço zero -> 400, código 3
POST {{host}}/api/Jogo
Content-Type: application/json

{ "nome": "Teste", "preco": 0, "estoque": 1, "idPlataforma": 1, "idCondicaoJogo": 1, "idsGeneros": [] }
###
# Reativar um jogo desativado: PUT com "ativo": true
PUT {{host}}/api/Jogo/1
Content-Type: application/json

{ "nome": "Super Mario World", "descricao": "Clássico de plataforma.", "preco": 199.90, "estoque": 3, "ativo": true, "idPlataforma": 1, "idCondicaoJogo": 1, "idsGeneros": [1] }
###
# Exclusão lógica (RN03): 200, o jogo só é desativado
DELETE {{host}}/api/Jogo/1
